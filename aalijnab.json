    {
      "id": 550268,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eشنیده شدن صدای چند انفجار در جزیره خارگ\u003cbr/\u003e\u003cbr/\u003eبر اساس بررسی‌های میدانی خبرنگار مهر، صدای انفجارها از محدوده لنگرگاه خارگ به گوش رسیده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
